<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Time Table Management System</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom Print Styling to format PDF export cleanly via window.print() */
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-area, #printable-area * {
                visibility: visible;
            }
            #printable-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background: white !important;
                color: black !important;
                box-shadow: none !important;
                margin: 0 !important;
                padding: 10px !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 h-full flex flex-col justify-between selection:bg-brand-500 selection:text-white">

    <!-- Header / Navigation -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-brand-600 text-white p-2.5 rounded-xl shadow-md shadow-brand-500/30 flex items-center justify-center">
                    <i class="fa-solid fa-calendar-days text-lg"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg text-slate-900 tracking-tight">TimeCraft <span class="text-brand-600 text-xs px-2 py-0.5 bg-brand-50 rounded-full font-semibold">Pro</span></h1>
                    <p class="text-xs text-slate-500 hidden sm:block">Smart Weekly Time Table Management System</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <button onclick="openAiGeneratorModal()" class="inline-flex items-center space-x-2 bg-gradient-to-r from-purple-600 to-brand-600 hover:from-purple-700 hover:to-brand-700 text-white px-3.5 py-2 rounded-xl text-sm font-medium shadow-sm transition-all transform active:scale-95">
                    <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i>
                    <span>AI Auto-Generate</span>
                </button>
                <button onclick="openModal()" class="inline-flex items-center space-x-2 bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-xl text-sm font-medium shadow-sm transition-all transform active:scale-95">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add Task / Class</span>
                </button>
                <button onclick="triggerPrint()" class="inline-flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium transition-all">
                    <i class="fa-solid fa-file-pdf text-rose-500"></i>
                    <span class="hidden sm:inline">Export PDF</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">

        <!-- Controls / Filters bar -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200 mb-8 no-print flex flex-col md:flex-row gap-4 items-center justify-between">
            <!-- Search & Filter inputs -->
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto flex-grow max-w-2xl">
                <div class="relative w-full">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" id="searchInput" oninput="filterTimetable()" placeholder="Search by subject, teacher, room..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all">
                </div>
                <div class="w-full sm:w-48">
                    <select id="dayFilter" onchange="filterTimetable()" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all">
                        <option value="All">All Days</option>
                        <option value="Monday">Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                        <option value="Saturday">Saturday</option>
                        <option value="Sunday">Sunday</option>
                    </select>
                </div>
            </div>

            <!-- View Mode Switcher & Clear All -->
            <div class="flex items-center justify-between w-full md:w-auto gap-3">
                <button onclick="analyzeScheduleWithAi()" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-purple-700 bg-purple-50 hover:bg-purple-100 border border-purple-200 transition-all flex items-center gap-1.5">
                    <i class="fa-solid fa-brain text-purple-600"></i>
                    <span>AI Review & Advice</span>
                </button>
                <div class="bg-slate-100 p-1 rounded-xl flex items-center space-x-1 border border-slate-200">
                    <button id="gridBtn" onclick="switchView('grid')" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-white text-slate-800 shadow-sm">
                        <i class="fa-solid fa-table-cells-large mr-1"></i> Grid
                    </button>
                    <button id="listBtn" onclick="switchView('list')" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-slate-600 hover:text-slate-900">
                        <i class="fa-solid fa-list mr-1"></i> List
                    </button>
                </div>
                <button onclick="confirmClearAll()" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-all flex items-center gap-1.5">
                    <i class="fa-solid fa-trash-can"></i>
                    <span>Clear All</span>
                </button>
            </div>
        </div>

        <!-- Timetable Stats Summary Bar -->
        <div class="flex items-center justify-between text-xs text-slate-500 mb-4 px-1 no-print">
            <div>
                Showing <span id="entryCount" class="font-semibold text-slate-800">0</span> scheduled class(es)
            </div>
        </div>

        <!-- Empty State View -->
        <div id="emptyState" class="hidden bg-white rounded-2xl p-12 text-center border border-slate-200 shadow-xs my-6">
            <div class="w-16 h-16 bg-brand-50 text-brand-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="fa-solid fa-calendar-xmark"></i>
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1">No Schedule Found</h3>
            <p class="text-xs text-slate-500 max-w-sm mx-auto mb-6">No matching timetable entries found. Add a new class manually or use AI Auto-Generate.</p>
            <div class="flex justify-center gap-3">
                <button onclick="openModal()" class="inline-flex items-center space-x-2 bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-xl text-xs font-medium transition-all">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add First Class</span>
                </button>
            </div>
        </div>

        <!-- Printable Schedule Container -->
        <div id="printable-area">
            <!-- Grid View (Weekly Board) -->
            <div id="gridViewContainer">
                <div id="weeklyGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7 gap-4">
                    <!-- Weekly columns dynamically populated -->
                </div>
            </div>

            <!-- List View (Table Format) -->
            <div id="listViewContainer" class="hidden bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider">
                                <th class="py-3 px-4">Day</th>
                                <th class="py-3 px-4">Time</th>
                                <th class="py-3 px-4">Subject</th>
                                <th class="py-3 px-4">Room / Location</th>
                                <th class="py-3 px-4">Teacher</th>
                                <th class="py-3 px-4 text-right no-print">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="listTableBody" class="divide-y divide-slate-100">
                            <!-- Dynamic rows injected here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <!-- ADD / EDIT TIMETABLE MODAL -->
    <div id="entryModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs hidden p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden border border-slate-100">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <h3 id="modalTitle" class="font-bold text-slate-900 text-base">Add New Timetable Entry</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg transition-all">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <form id="entryForm" onsubmit="handleFormSubmit(event)" class="p-6 space-y-4">
                <input type="hidden" id="entryId">

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Subject / Task Name *</label>
                    <input type="text" id="subjectName" required placeholder="e.g. Mathematics 101" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Day *</label>
                        <select id="entryDay" required class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all">
                            <option value="Monday">Monday</option>
                            <option value="Tuesday">Tuesday</option>
                            <option value="Wednesday">Wednesday</option>
                            <option value="Thursday">Thursday</option>
                            <option value="Friday">Friday</option>
                            <option value="Saturday">Saturday</option>
                            <option value="Sunday">Sunday</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Color Theme</label>
                        <select id="entryColor" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all">
                            <option value="indigo">Indigo</option>
                            <option value="emerald">Emerald</option>
                            <option value="amber">Amber</option>
                            <option value="purple">Purple</option>
                            <option value="cyan">Cyan</option>
                            <option value="rose">Rose</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Start Time *</label>
                        <input type="time" id="startTime" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">End Time *</label>
                        <input type="time" id="endTime" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Room / Venue</label>
                        <input type="text" id="roomLocation" placeholder="e.g. Room 302" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Teacher / Instructor</label>
                        <input type="text" id="teacherNotes" placeholder="e.g. Prof. Smith" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all">
                    </div>
                </div>

                <div class="pt-3 flex items-center justify-end space-x-3 border-t border-slate-100">
                    <button type="button" onclick="closeModal()" class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-sm font-medium transition-all">Cancel</button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium shadow-sm transition-all">Save Entry</button>
                </div>
            </form>
        </div>
    </div>

    <!-- AI SCHEDULE GENERATOR MODAL -->
    <div id="aiGeneratorModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs hidden p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden border border-slate-100">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-purple-50 to-indigo-50">
                <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles text-purple-600"></i> AI Smart Timetable Generator
                </h3>
                <button onclick="closeAiGeneratorModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg transition-all">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <p class="text-xs text-slate-600">Apna schedule text mein likhein (Hindi or English). AI automatically aapka poora timetable create kar dega!</p>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Schedule Prompt</label>
                    <textarea id="aiPromptInput" rows="4" placeholder="e.g. Main B.Tech 2nd year ka student hu. Monday se Friday subah 9 se 11 Math, 11 se 1 Physics room 101, Wednesday ko 2 se 4 Lab, and Saturday/Sunday subah 10 baje Self Study." class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all"></textarea>
                </div>
                <div class="pt-2 flex items-center justify-end space-x-3 border-t border-slate-100">
                    <button type="button" onclick="closeAiGeneratorModal()" class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-sm font-medium transition-all">Cancel</button>
                    <button id="aiGenerateBtn" onclick="generateScheduleWithAi()" class="px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-sm font-medium shadow-sm transition-all flex items-center gap-2">
                        <i class="fa-solid fa-bolt"></i> Generate Timetable
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- AI ADVICE / REVIEW MODAL -->
    <div id="aiAdviceModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs hidden p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden border border-slate-100 max-h-[90vh] flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-purple-50 to-brand-50">
                <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                    <i class="fa-solid fa-brain text-purple-600"></i> AI Schedule Analysis & Tips
                </h3>
                <button onclick="closeAiAdviceModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg transition-all">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div id="aiAdviceContent" class="p-6 overflow-y-auto text-sm text-slate-700 leading-relaxed space-y-3">
                <!-- AI feedback output injected here -->
            </div>
            <div class="p-4 border-t border-slate-100 bg-slate-50 text-right">
                <button onclick="closeAiAdviceModal()" class="px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium transition-all">Close</button>
            </div>
        </div>
    </div>

    <!-- CUSTOM MESSAGE BOX (Modal for Alert/Confirm without using alert()) -->
    <div id="customModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs hidden p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 text-center border border-slate-100">
            <div id="customModalIcon" class="w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-3 text-xl">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h4 id="customModalTitle" class="font-bold text-slate-900 text-base mb-1">Are you sure?</h4>
            <p id="customModalMessage" class="text-xs text-slate-500 mb-6">This action cannot be undone.</p>
            <div class="flex items-center justify-center space-x-3">
                <button id="customModalCancel" onclick="closeCustomModal()" class="w-full py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-sm font-medium transition-all">Cancel</button>
                <button id="customModalConfirm" class="w-full py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-medium shadow-sm transition-all">Confirm</button>
            </div>
        </div>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        
        // Open AI Generator Modal
        function openAiGeneratorModal() {
            document.getElementById('aiGeneratorModal').classList.remove('hidden');
        }

        function closeAiGeneratorModal() {
            document.getElementById('aiGeneratorModal').classList.add('hidden');
        }

        function closeAiAdviceModal() {
            document.getElementById('aiAdviceModal').classList.add('hidden');
        }

        // Call Gemini API to generate structured schedule from user text
        async function generateScheduleWithAi() {
            const promptText = document.getElementById('aiPromptInput').value.trim();
            if (!promptText) {
                showCustomModal('Input Required', 'Please enter your class or study routine prompt first.', 'warning', false);
                return;
            }

            const btn = document.getElementById('aiGenerateBtn');
            const originalBtnHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Generating...`;

            const systemPrompt = "You are a timetable assistant. Convert user prompt into a structured array of timetable items with properties: subject, day (Monday-Sunday), startTime (HH:MM in 24h format), endTime (HH:MM in 24h format), room (optional string), teacher (optional string), color (one of 'indigo','emerald','amber','rose','cyan','purple').";
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: promptText }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "ARRAY",
                        items: {
                            type: "OBJECT",
                            properties: {
                                subject: { type: "STRING" },
                                day: { type: "STRING" },
                                startTime: { type: "STRING" },
                                endTime: { type: "STRING" },
                                room: { type: "STRING" },
                                teacher: { type: "STRING" },
                                color: { type: "STRING" }
                            },
                            required: ["subject", "day", "startTime", "endTime"]
                        }
                    }
                }
            };

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error("AI request failed");

                const result = await response.json();
                const jsonText = result.candidates?.[0]?.content?.parts?.[0]?.text;
                if (!jsonText) throw new Error("Invalid response format");

                const newEntries = JSON.parse(jsonText);
                if (Array.isArray(newEntries) && newEntries.length > 0) {
                    newEntries.forEach(item => {
                        timetableData.push({
                            id: Date.now().toString() + Math.random().toString(36).substr(2, 4),
                            subject: item.subject || 'Class',
                            day: DAYS.includes(item.day) ? item.day : 'Monday',
        // Switch between Grid and List views safely
        function switchView(view) {
            currentView = view;
            const gridBtn = document.getElementById('gridBtn');
            const listBtn = document.getElementById('listBtn');
            const gridContainer = document.getElementById('gridViewContainer');
            const listContainer = document.getElementById('listViewContainer');

            if (gridBtn && listBtn && gridContainer && listContainer) {
                if (view === 'grid') {
                    gridBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-white text-slate-800 shadow-sm";
                    listBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-slate-600 hover:text-slate-900";
                    gridContainer.classList.remove('hidden');
                    listContainer.classList.add('hidden');
                } else {
                    listBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-white text-slate-800 shadow-sm";
                    gridBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-slate-600 hover:text-slate-900";
                    listContainer.classList.remove('hidden');
                    gridContainer.classList.add('hidden');
                }
            }
        }

        // Call Gemini API to analyze existing schedule and give smart feedback
        async function analyzeScheduleWithAi() {
            if (timetableData.length === 0) {
                showCustomModal('Empty Timetable', 'Please add some entries to your timetable first to analyze.', 'warning', false);
                return;
            }

            const modal = document.getElementById('aiAdviceModal');
            const content = document.getElementById('aiAdviceContent');
            content.innerHTML = `<div class="py-12 text-center text-purple-600"><i class="fa-solid fa-spinner fa-spin text-3xl mb-3"></i><p class="font-medium text-slate-700">Analyzing your weekly workload & balance...</p></div>`;
            modal.classList.remove('hidden');

            const systemPrompt = "You are an expert academic advisor and productivity coach. Analyze the user's weekly timetable data and provide concise, practical tips, workload warnings, and study recommendations in bullet points (in English/Hinglish). Use clear HTML formatting like <ul>, <li>, <strong>.";
            const userQuery = `Here is my current weekly timetable in JSON:\n` + JSON.stringify(timetableData);

            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] }
            };

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error("AI request failed");

                const result = await response.json();
                const adviceHtml = result.candidates?.[0]?.content?.parts?.[0]?.text;

                if (adviceHtml) {
                    content.innerHTML = adviceHtml;
                } else {
                    content.innerHTML = `<p class="text-rose-500">Unable to generate analysis at this moment.</p>`;
                }
            } catch (err) {
                console.error(err);
                content.innerHTML = `<p class="text-rose-500">Failed to generate AI analysis. Please try again later.</p>`;
            }
        }

        // Days order for structured weekly layout
        const DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
        
        // Color theme mappings for badges & cards
        const COLOR_CLASSES = {
            indigo: { bg: 'bg-indigo-50', border: 'border-indigo-100', text: 'text-indigo-700', badge: 'bg-indigo-100 text-indigo-800', dot: 'bg-indigo-500' },
            emerald: { bg: 'bg-emerald-50', border: 'border-emerald-100', text: 'text-emerald-700', badge: 'bg-emerald-100 text-emerald-800', dot: 'bg-emerald-500' },
            amber: { bg: 'bg-amber-50', border: 'border-amber-100', text: 'text-amber-700', badge: 'bg-amber-100 text-amber-800', dot: 'bg-amber-500' },
            rose: { bg: 'bg-rose-50', border: 'border-rose-100', text: 'text-rose-700', badge: 'bg-rose-100 text-rose-800', dot: 'bg-rose-500' },
            cyan: { bg: 'bg-cyan-50', border: 'border-cyan-100', text: 'text-cyan-700', badge: 'bg-cyan-100 text-cyan-800', dot: 'bg-cyan-500' },
            purple: { bg: 'bg-purple-50', border: 'border-purple-100', text: 'text-purple-700', badge: 'bg-purple-100 text-purple-800', dot: 'bg-purple-500' }
        };

        // Application State Data loaded from LocalStorage or Default Sample Data
        let timetableData = JSON.parse(localStorage.getItem('timetableData')) || [
            { id: '1', subject: 'Mathematics 101', day: 'Monday', startTime: '09:00', endTime: '10:30', room: 'Room 302', teacher: 'Dr. Alan Turing', color: 'indigo' },
            { id: '2', subject: 'Data Structures', day: 'Monday', startTime: '11:00', endTime: '12:30', room: 'Lab 2', teacher: 'Prof. Ada Lovelace', color: 'emerald' },
            { id: '3', subject: 'Physics Lecture', day: 'Tuesday', startTime: '10:00', endTime: '11:30', room: 'Auditorium A', teacher: 'Dr. R. Feynman', color: 'amber' },
            { id: '4', subject: 'Web Development', day: 'Wednesday', startTime: '14:00', endTime: '16:00', room: 'Lab 4', teacher: 'Tim Berners', color: 'cyan' },
            { id: '5', subject: 'English Literature', day: 'Thursday', startTime: '09:30', endTime: '11:00', room: 'Room 105', teacher: 'Ms. Emily Bronte', color: 'purple' },
            { id: '6', subject: 'Project Seminar', day: 'Friday', startTime: '13:00', endTime: '15:00', room: 'Conference Hall', teacher: 'Department Head', color: 'rose' }
        ];

        let currentView = 'grid'; // 'grid' or 'list'

        // Security helper to escape HTML
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;')
                      .replace(/</g, '&lt;')
                      .replace(/>/g, '&gt;')
                      .replace(/"/g, '&quot;')
                      .replace(/'/g, '&#039;');
        }

        // Helper to format time into 12-hour AM/PM format
        function formatTime(timeStr) {
            if (!timeStr) return '';
            const [hours, minutes] = timeStr.split(':');
            let h = parseInt(hours, 10);
            const ampm = h >= 12 ? 'PM' : 'AM';
            h = h % 12;
            h = h ? h : 12;
            return `${h}:${minutes} ${ampm}`;
        }

        // Filter timetable on search or day change
        function filterTimetable() {
            renderTimetable();
        }

        // Save data to localStorage
        function saveData() {
            localStorage.setItem('timetableData', JSON.stringify(timetableData));
            renderTimetable();
        }

        // Switch between Grid and List views
        function switchView(view) {
            currentView = view;
            const gridBtn = document.getElementById('gridBtn');
            const listBtn = document.getElementById('listBtn');
            const gridContainer = document.getElementById('gridViewContainer');
            const listContainer = document.getElementById('listViewContainer');

            if (view === 'grid') {
                gridBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-white text-slate-800 shadow-sm";
                listBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-slate-600 hover:text-slate-900";
                gridContainer.classList.remove('hidden');
                listContainer.classList.add('hidden');
            } else {
                listBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium transition-all bg-white text-slate-800 shadow-sm";
                gridBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-slate-600 hover:text-slate-900";
                listContainer.classList.remove('hidden');
                gridContainer.classList.add('hidden');
            }
        }

        // Render main timetable based on filters
        function renderTimetable() {
            const searchElem = document.getElementById('searchInput');
            const dayElem = document.getElementById('dayFilter');
            const searchQuery = searchElem ? searchElem.value.toLowerCase().trim() : '';
            const selectedDayFilter = dayElem ? dayElem.value : 'All';

            // Filter data
            let filteredData = timetableData.filter(item => {
                const matchesSearch = item.subject.toLowerCase().includes(searchQuery) ||
                                      item.teacher.toLowerCase().includes(searchQuery) ||
                                      item.room.toLowerCase().includes(searchQuery);
                const matchesDay = selectedDayFilter === 'All' || item.day === selectedDayFilter;
                return matchesSearch && matchesDay;
            });

            // Sort by start time within each day
            filteredData.sort((a, b) => a.startTime.localeCompare(b.startTime));

            const entryCountElem = document.getElementById('entryCount');
            if (entryCountElem) entryCountElem.innerText = filteredData.length;

            const emptyState = document.getElementById('emptyState');
            const gridContainer = document.getElementById('gridViewContainer');
            const listContainer = document.getElementById('listViewContainer');

            if (filteredData.length === 0) {
                if (emptyState) emptyState.classList.remove('hidden');
                if (gridContainer) gridContainer.classList.add('hidden');
                if (listContainer) listContainer.classList.add('hidden');
                return;
            } else {
                if (emptyState) emptyState.classList.add('hidden');
                if (currentView === 'grid') {
                    if (gridContainer) gridContainer.classList.remove('hidden');
                } else {
                    if (listContainer) listContainer.classList.remove('hidden');
                }
            }

            // Render Grid View
            renderGridView(filteredData, selectedDayFilter);

            // Render List View
            renderListView(filteredData);
        }

        // Render Weekly Grid View
        function renderGridView(data, dayFilter) {
            const weeklyGrid = document.getElementById('weeklyGrid');
            if (!weeklyGrid) return;
            weeklyGrid.innerHTML = '';

            const daysToRender = dayFilter === 'All' ? DAYS : [dayFilter];

            daysToRender.forEach(day => {
                const dayEntries = data.filter(item => item.day === day);
                
                let cardsHtml = '';
                if (dayEntries.length === 0) {
                    cardsHtml = `
                        <div class="py-8 text-center border-2 border-dashed border-slate-200 rounded-xl">
                            <p class="text-xs text-slate-400 font-medium">No classes</p>
                        </div>
                    `;
                } else {
                    cardsHtml = dayEntries.map(entry => {
                        const theme = COLOR_CLASSES[entry.color] || COLOR_CLASSES.indigo;
                        return `
                            <div class="${theme.bg} border ${theme.border} rounded-xl p-3.5 shadow-xs hover:shadow-md transition-all relative group">
                                <div class="flex items-start justify-between mb-1.5">
                                    <span class="text-xs font-bold ${theme.text} px-2 py-0.5 rounded-md bg-white/80 shadow-2xs">
                                        ${formatTime(entry.startTime)} - ${formatTime(entry.endTime)}
                                    </span>
                                    <div class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center space-x-1 no-print">
                                        <button onclick="editEntry('${entry.id}')" class="p-1 text-slate-500 hover:text-brand-600 transition-colors" title="Edit">
                                            <i class="fa-solid fa-pen text-xs"></i>
                                        </button>
                                        <button onclick="deleteEntry('${entry.id}')" class="p-1 text-slate-500 hover:text-rose-600 transition-colors" title="Delete">
                                            <i class="fa-solid fa-trash text-xs"></i>
                                        </button>
                                    </div>
                                </div>
                                <h4 class="font-bold text-slate-900 text-sm mb-1">${escapeHtml(entry.subject)}</h4>
                                ${entry.room ? `<p class="text-xs text-slate-600 flex items-center gap-1.5 mb-0.5"><i class="fa-solid fa-location-dot text-slate-400 w-3"></i> ${escapeHtml(entry.room)}</p>` : ''}
                                ${entry.teacher ? `<p class="text-xs text-slate-600 flex items-center gap-1.5"><i class="fa-solid fa-chalkboard-user text-slate-400 w-3"></i> ${escapeHtml(entry.teacher)}</p>` : ''}
                            </div>
                        `;
                    }).join('');
                }

                const dayColumn = `
                    <div class="bg-slate-50/80 rounded-2xl p-3.5 border border-slate-200/80 flex flex-col">
                        <div class="pb-3 mb-3 border-b border-slate-200 flex items-center justify-between">
                            <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-brand-500"></span>
                                ${day}
                            </h3>
                            <span class="text-[11px] font-semibold bg-slate-200/70 text-slate-600 px-2 py-0.5 rounded-full">${dayEntries.length}</span>
                        </div>
                        <div class="space-y-3 flex-grow">
                            ${cardsHtml}
                        </div>
                    </div>
                `;
                weeklyGrid.insertAdjacentHTML('beforeend', dayColumn);
            });
        }

        // Render List Table View
        function renderListView(data) {
            const tbody = document.getElementById('listTableBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            data.forEach((entry) => {
                const theme = COLOR_CLASSES[entry.color] || COLOR_CLASSES.indigo;
                const row = `
                    <tr class="hover:bg-slate-50/80 transition-colors border-b border-slate-100 last:border-none">
                        <td class="py-3.5 px-4 font-semibold text-slate-800">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-xs">
                                <span class="w-1.5 h-1.5 rounded-full ${theme.dot}"></span>
                                ${entry.day}
                            </span>
                        </td>
                        <td class="py-3.5 px-4 text-slate-600 font-medium text-xs whitespace-nowrap">
                            ${formatTime(entry.startTime)} &ndash; ${formatTime(entry.endTime)}
                        </td>
                        <td class="py-3.5 px-4 font-bold text-slate-900">
                            ${escapeHtml(entry.subject)}
                        </td>
                        <td class="py-3.5 px-4 text-slate-600">
                            ${entry.room ? `<span class="inline-flex items-center gap-1"><i class="fa-solid fa-location-dot text-slate-400 text-xs"></i> ${escapeHtml(entry.room)}</span>` : '<span class="text-slate-300">&mdash;</span>'}
                        </td>
                        <td class="py-3.5 px-4 text-slate-600">
                            ${entry.teacher ? `<span class="inline-flex items-center gap-1"><i class="fa-solid fa-chalkboard-user text-slate-400 text-xs"></i> ${escapeHtml(entry.teacher)}</span>` : '<span class="text-slate-300">&mdash;</span>'}
                        </td>
                        <td class="py-3.5 px-4 text-right no-print">
                            <button onclick="editEntry('${entry.id}')" class="p-1.5 text-slate-400 hover:text-brand-600 transition-colors rounded-lg hover:bg-slate-100 mr-1" title="Edit">
                                <i class="fa-solid fa-pen text-xs"></i>
                            </button>
                            <button onclick="deleteEntry('${entry.id}')" class="p-1.5 text-slate-400 hover:text-rose-600 transition-colors rounded-lg hover:bg-rose-50" title="Delete">
                                <i class="fa-solid fa-trash text-xs"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }

        function openModal(isEdit = false) {
            document.getElementById('entryModal').classList.remove('hidden');
            if (!isEdit) {
                document.getElementById('modalTitle').innerText = 'Add New Timetable Entry';
                document.getElementById('entryForm').reset();
                document.getElementById('entryId').value = '';
            }
        }

        function closeModal() {
            document.getElementById('entryModal').classList.add('hidden');
        }

        function handleFormSubmit(event) {
            event.preventDefault();

            const id = document.getElementById('entryId').value;
            const subject = document.getElementById('subjectName').value.trim();
            const day = document.getElementById('entryDay').value;
            const startTime = document.getElementById('startTime').value;
            const endTime = document.getElementById('endTime').value;
            const room = document.getElementById('roomLocation').value.trim();
            const teacher = document.getElementById('teacherNotes').value.trim();
            const color = document.getElementById('entryColor').value;

            if (startTime >= endTime) {
                showCustomModal('Invalid Time', 'End time must be later than start time.', 'error', false);
                return;
            }

            if (id) {
                const index = timetableData.findIndex(item => item.id === id);
                if (index !== -1) {
                    timetableData[index] = { id, subject, day, startTime, endTime, room, teacher, color };
                }
            } else {
                const newEntry = {
                    id: Date.now().toString(),
                    subject,
                    day,
                    startTime,
                    endTime,
                    room,
                    teacher,
                    color
                };
                timetableData.push(newEntry);
            }

            saveData();
            closeModal();
        }

        function editEntry(id) {
            const entry = timetableData.find(item => item.id === id);
            if (!entry) return;

            document.getElementById('modalTitle').innerText = 'Edit Timetable Entry';
            document.getElementById('entryId').value = entry.id;
            document.getElementById('subjectName').value = entry.subject;
            document.getElementById('entryDay').value = entry.day;
            document.getElementById('startTime').value = entry.startTime;
            document.getElementById('endTime').value = entry.endTime;
            document.getElementById('roomLocation').value = entry.room || '';
            document.getElementById('teacherNotes').value = entry.teacher || '';
            document.getElementById('entryColor').value = entry.color || 'indigo';

            document.getElementById('entryModal').classList.remove('hidden');
        }

        function deleteEntry(id) {
            showCustomModal('Delete Entry', 'Are you sure you want to delete this timetable entry?', 'warning', true, () => {
                timetableData = timetableData.filter(item => item.id !== id);
                saveData();
                closeCustomModal();
            });
        }

        function confirmClearAll() {
            if (timetableData.length === 0) {
                showCustomModal('Notice', 'Timetable is already empty.', 'info', false);
                return;
            }
            showCustomModal('Clear All Entries', 'Are you sure you want to delete all timetable entries? This cannot be undone.', 'warning', true, () => {
                timetableData = [];
                saveData();
                closeCustomModal();
            });
        }

        function triggerPrint() {
            window.print();
        }

        function showCustomModal(title, message, type = 'warning', showConfirm = true, onConfirm = null) {
            const modal = document.getElementById('customModal');
            document.getElementById('customModalTitle').innerText = title;
            document.getElementById('customModalMessage').innerText = message;
            
            const iconDiv = document.getElementById('customModalIcon');
            const confirmBtn = document.getElementById('customModalConfirm');
            const cancelBtn = document.getElementById('customModalCancel');

            if (type === 'error' || type === 'warning') {
                iconDiv.className = 'w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-3 text-xl';
                iconDiv.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
                confirmBtn.className = 'w-full py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-medium shadow-sm transition-all';
            } else {
                iconDiv.className = 'w-12 h-12 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center mx-auto mb-3 text-xl';
                iconDiv.innerHTML = '<i class="fa-solid fa-circle-info"></i>';
                confirmBtn.className = 'w-full py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium shadow-sm transition-all';
            }

            if (!showConfirm) {
                confirmBtn.classList.add('hidden');
                cancelBtn.innerText = 'OK';
                cancelBtn.className = 'w-full py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium shadow-sm transition-all';
            } else {
                confirmBtn.classList.remove('hidden');
                cancelBtn.innerText = 'Cancel';
                cancelBtn.className = 'w-full py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-sm font-medium transition-all';
                confirmBtn.onclick = function() {
                    if (onConfirm) onConfirm();
                };
            }

            modal.classList.remove('hidden');
        }

        function closeCustomModal() {
            document.getElementById('customModal').classList.add('hidden');
        }

        // Initialize application on DOM ready / load
        window.addEventListener('DOMContentLoaded', function() {
            renderTimetable();
        });
    </script>
</body>
</html>